# The Liquorify backend the storefront's browser tests run against, read by
# scripts/e2e/liquorify-backend.sh and scripts/e2e/bootstrap-spree.sh.
#
# LIQUORIFY_REVISION is the backend commit under test. Change it in its own
# commit, with each backend merge the storefront depends on, or when the owner
# asks.
LIQUORIFY_REPOSITORY=https://github.com/pateldhruval872/liquorify.git
LIQUORIFY_REVISION=68236c59c7ad9b60e36a437a34b039e52d123e05

# The Rails application that hosts the backend's gems, until Liquorify decides
# where its own host application lives (FB-05): Spree's starter at the commit
# that moved it to 6.0.0.rc4, the version the backend is on. Its Gemfile.lock
# fixes every third-party gem; only the Spree gems come from the backend.
HOST_APP_REPOSITORY=https://github.com/spree/spree-starter.git
HOST_APP_REVISION=a853a630a295898f8195da38cef59d061adcdb0d

# Runtime settings for a disposable test backend that is never exposed off the
# machine running it. They mirror docker-compose.yml's `web` service.
RAILS_ENV=production
SECRET_KEY_BASE=e2e_secret_key_base_not_for_production_use_only_e2e_e2e_e2e_e2e
ADMIN_EMAIL=e2e@example.com
ADMIN_PASSWORD=spree123
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false
RAILS_HOST=localhost:4000
SOLID_QUEUE_IN_PUMA=false
SPREE_RATE_LIMIT_REGISTER=1000
SPREE_RATE_LIMIT_LOGIN=1000
SPREE_RATE_LIMIT_REFRESH=1000
